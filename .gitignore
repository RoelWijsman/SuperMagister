# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# ingepakte extensie (npm run extension:zip)
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# back-ups van de projectmap
*-backup-*/
backup/

# systeembestanden
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
._*
*.swp
*~

# lokale instellingen (editor en Claude Code)
.vscode/*
!.vscode/extensions.json
.idea/
.claude/settings.local.json

# Magister: echte responses, HAR-bestanden en tokens komen NOOIT in git.
# Zet ruwe voorbeelden in magister-voorbeelden/; alleen geanonimiseerde
# testbestanden (lib/magister/__fixtures__) gaan wel mee.
/magister-voorbeelden/
*.har
*.har.json
