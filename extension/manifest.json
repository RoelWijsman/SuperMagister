{
  "manifest_version": 3,
  "name": "SuperMagister",
  "short_name": "SuperMagister",
  "version": "0.5.0",
  "description": "Koppelt SuperMagister met je eigen Magister, zonder wachtwoord. Onofficieel; niet verbonden aan Magister of Iddink.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SuperMagister",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://*.magister.net/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://*.magister.net/*"],
      "exclude_matches": ["https://accounts.magister.net/*"],
      "js": ["shared/protocol.js", "shared/magister-session.js", "content/magister.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["shared/protocol.js", "content/app.js"],
      "run_at": "document_start"
    }
  ]
}
