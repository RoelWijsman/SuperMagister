# SuperMagister: omgevingsvariabelen.
# Kopieer dit bestand naar .env.local voor lokaal gebruik. Zet echte geheimen
# NOOIT in dit bestand of in git: alleen in .env.local (staat in .gitignore) en
# in Vercel (Settings → Environment Variables).

# ——— Het adres van de site ————————————————————————————————————————————————

# Het adres waarop SuperMagister draait, zonder slash aan het eind en zonder www.
# Wordt gebruikt voor de bladwijzer, de deelafbeelding, robots.txt en de sitemap.
#   Lokaal:  http://localhost:3000
#   Vercel:  https://supermagister.nl (alleen bij "Production" invullen; previews
#            gebruiken dan vanzelf hun eigen adres voor de bladwijzer)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Privé ontwikkelaarsdashboard ————————————————————————————————————————————
# Alle drie nodig; ontbreekt er één (of klopt hij niet), dan bestaat het
# dashboard niet en geeft elk adres de gewone 404. De server logt dan wát er
# niet klopt (nooit de waarden). Controleren: npm run dashboard:check Maak ze willekeurig, bijv. met
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"

# Het geheime adres: minstens 8 tekens (letters, cijfers, - _ . ~), met of zonder
# slash vooraan en hoofdletters maken niet uit. Niet beginnen met api of _next.
# Voorbeeld: /dev-Xk3v9x7q2Lr8
DEV_DASHBOARD_PATH=

# Het wachtwoord om in te loggen (minstens 8 tekens). Een nieuw wachtwoord
# maakt alle bestaande sessies meteen ongeldig.
DEV_DASHBOARD_PASSWORD=

# De sleutel voor de inlogpagina: zonder ?key=<deze waarde> is ook de
# inlogpagina een 404. Minstens 8 tekens, alleen letters, cijfers, - en _.
DEV_DASHBOARD_KEY=

# Optioneel: de directe link naar Vercel Analytics van dit project, bijv.
# https://vercel.com/<jouw-team>/supermagister/analytics. Leeg = Vercels
# "kies je project"-link.
DEV_DASHBOARD_ANALYTICS_URL=

# ——— Opslag voor de anonieme tellers (Upstash Redis) ————————————————————————
# Vult Vercel vanzelf in als je Upstash via de Marketplace koppelt (dan heten ze
# KV_REST_API_URL en KV_REST_API_TOKEN; die worden ook gelezen). Leeg = er wordt
# niets bewaard en het dashboard zegt "geen opslag gekoppeld".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
